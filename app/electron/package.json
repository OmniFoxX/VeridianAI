{
  "name": "veridianai",
  "version": "2.16.2",
  "description": "VeridianAI — Local Multi-Tier Multi-AI Instance Training/Inference Interface",
  "author": "MentiSphere Software",
  "homepage": "https://github.com/OmniFoxX",
  "repository": "https://github.com/OmniFoxX",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "genmanifest": "py ../backend/build_integrity.py genmanifest",
    "pack-win": "npm run genmanifest && electron-builder --win --dir",
    "build-win": "npm run genmanifest && electron-builder --win",
    "build-store": "echo ERROR: the Microsoft Store package is NOT built from this tree. Use the WinStoreApp tree under STAGING (its electron/ folder). This tree has no extraFiles, so it would produce an appx containing only the Electron shell. && exit 1",
    "build-linux": "py ../backend/build_integrity.py genmanifest && electron-builder --linux",
    "build-mac": "py ../backend/build_integrity.py genmanifest && electron-builder --mac",
    "deps": "npm ci",
    "deps-audit": "npm audit --audit-level=high",
    "deps-verify": "npm audit signatures",
    "build-store-test": "echo ERROR: the Microsoft Store package is NOT built from this tree. Use the WinStoreApp tree under STAGING (its electron/ folder). This tree has no extraFiles, so it would produce an appx containing only the Electron shell. && exit 1"
  },
  "build": {
    "appId": "software.mentisphere.veridianai",
    "productName": "VeridianAI",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "../dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "appx": {
      "identityName": "MentiSphereSoftware.VeridianAI",
      "publisher": "CN=46BD9046-C73A-4C1C-81C3-6702E8ABC061",
      "publisherDisplayName": "MentiSphere Software",
      "applicationId": "VeridianAI",
      "displayName": "VeridianAI",
      "capabilities": [
        "runFullTrust",
        "privateNetworkClientServer",
        "broadFileSystemAccess"
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  },
  "devDependencies": {
    "electron": "42.7.1",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "fast-uri": ">=3.1.5"
  }
}
