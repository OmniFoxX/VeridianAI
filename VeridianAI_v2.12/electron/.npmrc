# VeridianAI - npm hardening (v2.12.20, 2026-08-04)
#
# Written the day the "Shai-Hulud"/keyv worm swept ~434 npm packages across
# 1,300+ versions. That worm's entire execution mechanism was a single line:
#
#     "preinstall": "node setup.mjs"
#
# added to each hijacked package.json. Anyone running `npm install` against a
# poisoned version executed attacker code before the install even finished.
#
# ignore-scripts=true removes that mechanism outright. It is the highest-value
# single control against this whole attack class, and it is FREE here:
# electron@42.7.1 and electron-builder@26.15.3 declare no install scripts at
# all, and the only package in the 314-package tree that does -- electron-
# winstaller (`node ./script/select-7z-arch.js`) -- exists for Squirrel
# installers, which this project does not build. We ship NSIS + MSIX.
#
# If a future dependency genuinely needs its install script, do NOT flip this
# back globally. Run it explicitly and deliberately for that one package:
#     npm rebuild <package>
ignore-scripts=true

# Fail an install on a known HIGH/CRITICAL advisory rather than printing a
# warning nobody reads.
audit-level=high

# Never let a bare `npm install <pkg>` quietly widen a range. New deps get
# pinned to the exact version that was reviewed.
save-exact=true
